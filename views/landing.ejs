<!DOCTYPE html>
<head>
  <meta name="viewport" content="width=device-width" />
  <title>Forme</title>
  <link rel="stylesheet" href="/style.css" />
  <script type="module"
  src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js">
</script>
</head>
<body class="landing-page">
  <%- include('partials/lang-switcher') %>

  <!-- ── LANDING ── -->
  <div id="page-landing" class="page active">
    <div class="card landing-card">
      
      <h1 class="landing-brand">Forme</h1>
      <p class="big-text" data-i18n="landing.welcome">Welcome to Forme!</p>
      <p data-i18n="landing.subtitle">Let's find out the pattern for you</p>
      <button onclick="startQuiz()" data-i18n="landing.enter">Start Quiz</button>
      <div class="landing-skip-row">
        <a href="/gallery" class="landing-skip-btn" data-i18n="landing.skipTheQuiz">Skip the Quiz</a>
      </div>
    </div>
  </div>

  <!-- ── QUIZ ── -->
  <div id="page-quiz" class="page hidden"></div>

  <!-- ── RESULT ── -->
  <div id="page-result" class="page hidden">
    <div class="card result-card">
      <h2 data-i18n="result.yourPattern">Your pattern:</h2>
      <h3 id="result-pattern-name" class="result-pattern-name"></h3>
      <div class="pattern-preview result-pattern-preview">
        <model-viewer
          id="pattern-model"
          class="pattern-model"
          camera-controls
          auto-rotate
          interaction-prompt="none"
          shadow-intensity="1">
        </model-viewer>
      </div>
      <h2 data-i18n="result.explanation">Explanation:</h2>
      <p id="result-explanation"></p>
      <a href="/pattern-detail" class="btn-primary" data-i18n="result.startCreating">Start Creating</a>
    </div>
  </div>

  <script src="/translations.js"></script>
  <script src="/lang.js"></script>
  <script src="/questions.js"></script>
  <script src="/pattern.js"></script>
  <script src="/quiz.js"></script>
</body>
</html>
