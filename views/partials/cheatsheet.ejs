<aside class="cheatsheet">
  <h3>Stitch Cheatsheet</h3>

  <div class="cheat-row" tabindex="0">
    <strong>MR</strong>
    <div class="cheat-detail">
      <span>Magic Ring</span>
      <small>Adjustable loop to start crocheting in the round.</small>
    </div>
  </div>

  <div class="cheat-row" tabindex="0">
    <strong>sc</strong>
    <div class="cheat-detail">
      <span>Single Crochet</span>
      <small>Basic short crochet stitch.</small>
    </div>
  </div>

  <div class="cheat-row" tabindex="0">
    <strong>inc</strong>
    <div class="cheat-detail">
      <span>Increase</span>
      <small>2 sc in the same stitch.</small>
    </div>
  </div>

  <div class="cheat-row" tabindex="0">
    <strong>dec</strong>
    <div class="cheat-detail">
      <span>Decrease</span>
      <small>sc2tog: combine 2 stitches into one.</small>
    </div>
  </div>

  <div class="cheat-row" tabindex="0">
    <strong>ch</strong>
    <div class="cheat-detail">
      <span>Chain</span>
      <small>Basic foundation stitch.</small>
    </div>
  </div>

  <div class="cheat-row" tabindex="0">
    <strong>sl st</strong>
    <div class="cheat-detail">
      <span>Slip Stitch</span>
      <small>Used to join or move without adding height.</small>
    </div>
  </div>

  <div class="cheat-row" tabindex="0">
    <strong>hdc</strong>
    <div class="cheat-detail">
      <span>Half Double Crochet</span>
      <small>Medium-height stitch.</small>
    </div>
  </div>

  <div class="cheat-row" tabindex="0">
    <strong>dc</strong>
    <div class="cheat-detail">
      <span>Double Crochet</span>
      <small>Taller stitch.</small>
    </div>
  </div>

  <div class="cheat-row" tabindex="0">
    <strong>tr</strong>
    <div class="cheat-detail">
      <span>Treble Crochet</span>
      <small>Very tall stitch.</small>
    </div>
  </div>

  <div class="cheat-row" tabindex="0">
    <strong>×n</strong>
    <div class="cheat-detail">
      <span>Repeat</span>
      <small>Repeat the sequence n times.</small>
    </div>
  </div>

  <div class="cheat-row" tabindex="0">
    <strong>( )</strong>
    <div class="cheat-detail">
      <span>Group</span>
      <small>Instructions inside are grouped or repeated together.</small>
    </div>
  </div>
</aside>
