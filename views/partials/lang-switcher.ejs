<aside class="lang-switcher" aria-label="Language switcher">
  <p class="lang-switcher-label" data-i18n="ui.language">Language</p>
  <div class="lang-switcher-options">
    <button type="button" class="lang-switcher-btn" data-lang-choice="en" onclick="chooseLang('en')">EN</button>
    <button type="button" class="lang-switcher-btn" data-lang-choice="zh" onclick="chooseLang('zh')">中</button>
  </div>
</aside>
