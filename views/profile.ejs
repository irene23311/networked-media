<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profile</title>
  <link rel="stylesheet" href="/style.css" />
  <script type="module"
    src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js">
  </script>
</head>
<body>
  <%- include('partials/lang-switcher') %>
  <nav>
    <div class="nav-left">
      <a href="/about" data-i18n="nav.about">About</a>
      <a href="/gallery" data-i18n="nav.gallery">Gallery</a>
    </div>
    <div class="nav-center">
      <a href="/">Forme</a>
    </div>
    <div class="nav-right">
      <a href="/profile" data-i18n="nav.profile">Profile</a>
    </div>
  </nav>

  <main class="page page-top">
    <div class="profile-layout">
      <aside class="profile-sidebar">
        <div class="card profile-id-card">
          <p class="profile-label" data-i18n="profile.patternType">Your match</p>
          <h2 id="profile-pattern-name">—</h2>
          <p id="profile-explanation" class="profile-explanation muted-copy"></p>
        </div>
      </aside>

      <div class="profile-main">
        <div class="profile-model-wrap">
          <model-viewer
            id="pattern-model-detail"
            class="pattern-model-detail"
            camera-controls
            auto-rotate
            interaction-prompt="none"
            shadow-intensity="1">
          </model-viewer>
        </div>

        <div class="profile-cta-row">
          <div class="profile-meta-chips">
            <span class="meta-chip" id="profile-yarn"></span>
            <span class="meta-chip" id="profile-hook"></span>
            <span class="meta-chip" id="profile-skill"></span>
          </div>
          <a href="/pattern-detail" class="btn-primary" data-i18n="profile.viewDetails">Continue making</a>
        </div>
      </div>
    </div>
  </main>

  <script src="/translations.js"></script>
  <script src="/lang.js"></script>
  <script src="/pattern.js"></script>
  <script src="/profile.js"></script>
</body>
</html>
